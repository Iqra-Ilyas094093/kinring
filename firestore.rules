rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isAdmin(groupId) {
      return signedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Handles a known Firestore gotcha: in GroupsViewModel.joinGroup, the
    // member-doc create and this memberIds update happen in ONE batch.
    // Security rules evaluate every write in a batch against the
    // database state from BEFORE the batch started — so by the time
    // this rule runs, it can't yet "see" the member doc the same batch
    // is also creating, and isMember(groupId) reads false even though
    // the join is legitimate. This lets a self-join through on its own
    // narrow terms — exactly one uid added, and it must be the caller's
    // own — without opening the door to arbitrary membership edits.
    function isSelfJoin(groupId) {
      return signedIn() &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
        request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
        request.auth.uid in request.resource.data.memberIds &&
        !(request.auth.uid in resource.data.memberIds);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember(groupId) || isSelfJoin(groupId);
      allow delete: if isAdmin(groupId);

      match /members/{uid} {
        // FIX: Allow signedIn() instead of isMember() to stop infinite recursion
        allow read: if signedIn();
        allow create: if signedIn() && (request.auth.uid == uid || isAdmin(groupId));
        allow update: if isAdmin(groupId) || request.auth.uid == uid;
        allow delete: if isAdmin(groupId) || request.auth.uid == uid;
      }

      match /events/{eventId} {
        // Back to isMember(groupId). A resource.data-based check (e.g.
        // `uid in resource.data.memberIds`) only works for list queries
        // that ALSO filter on that same field in the query itself.
        // listenGroupEvents / the per-group version of listenUpcomingEvents
        // filter only on timeUTC, not memberIds — under a resource.data
        // rule Firestore can't prove those queries safe and denies them
        // outright, every time. isMember(groupId) doesn't touch
        // resource.data at all (just checks membership via the group
        // path), so it works for every read shape under events/,
        // collectionGroup or not. EventsViewModel.listenUpcomingEvents no
        // longer uses collectionGroup — it fans out per-group — so this
        // is safe for both Home and Group Details.
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(groupId);
        allow delete: if isAdmin(groupId) || isMember(groupId);

        match /statuses/{uid} {
          allow read: if isMember(groupId);
          // Self-write: your own status doc (ringing/cleared/snoozed).
          allow write: if isMember(groupId) && request.auth.uid == uid;
          // Admin force-stop: a group admin may write to a DIFFERENT
          // member's status doc, but ONLY to force-clear it.
          allow write: if isAdmin(groupId) &&
            request.auth.uid != uid &&
            request.resource.data.status == 'cleared' &&
            request.resource.data.forceStoppedByAdmin == true;
        }
      }

      // Chat System — product doc Part 15. Text-only: create is allowed,
      // update/delete is not (no edit/delete per Part 15.1 scope).
      match /messages/{messageId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /notifications/{uid}/items/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
